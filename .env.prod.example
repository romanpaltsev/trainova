# Прод-окружение. Скопируйте в .env.prod на сервере и заполните.
# .env.prod в git не попадает (закрыт .gitignore) — храните его только на VDS.

# --- Django
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=замените-на-случайный-ключ
DJANGO_DEBUG=False

# --- Домен
# Сертификатами и TLS занимается системный nginx с системным certbot,
# поэтому здесь домен нужен только Django.
DJANGO_ALLOWED_HOSTS=trainova.hotbar.pro
CSRF_TRUSTED_ORIGINS=https://trainova.hotbar.pro

# --- Порт приложения
# Контейнер публикует его только на 127.0.0.1 — снаружи ходит лишь nginx.
# Меняйте, если 8000 на сервере уже занят.
WEB_PORT=8000

# --- База
POSTGRES_DB=trainova
POSTGRES_USER=trainova
POSTGRES_PASSWORD=замените-на-длинный-пароль
DATABASE_URL=postgres://trainova:замените-на-длинный-пароль@db:5432/trainova
DJANGO_DB_CONN_MAX_AGE=60

# --- Прод-режим статики и безопасности
DJANGO_STATIC_MANIFEST=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_COOKIE_SECURE=True
# 31536000 = год. Начните с 3600: HSTS запрещает браузеру ходить на домен по HTTP,
# и ошибка с сертификатом становится трудно откатываемой.
DJANGO_SECURE_HSTS_SECONDS=3600

# --- Gunicorn
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# --- Почта (Яндекс: пароль приложения, а не пароль от ящика)
# Значения с пробелами и угловыми скобками берите в кавычки.
# Символ @ в логине кодируется как %40, спецсимволы пароля — тоже (%-кодирование).
EMAIL_URL=smtp+ssl://dnevnik%40yandex.ru:parolprilozheniya@smtp.yandex.ru:465
# From обязан совпадать с ящиком из EMAIL_URL, иначе Яндекс отклонит отправку.
DEFAULT_FROM_EMAIL="Дневник тренировок <dnevnik@yandex.ru>"

# --- Бэкапы (используются scripts/backup.sh)
BACKUP_DIR=/var/backups/trainova
BACKUP_RCLONE_REMOTE=backup:trainova-backups
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=90
